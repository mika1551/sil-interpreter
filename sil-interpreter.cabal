cabal-version:      3.0
name:               sil-interpreter
version:            0.1.0.0
build-type:         Simple

library
  hs-source-dirs:   src
  exposed-modules:  AST, CLI, Interpreter, Json, JsonParser, Machine, MachineInterpreter, MachineParser, Parser
  other-modules:    JsonValidation, Operations
  default-language: Haskell2010
  build-depends:    base >=4.14 && <5, aeson >=2.2.1 && <2.3, array, containers, megaparsec, scientific, text
  ghc-options:      -Wall

executable sil-interpreter
  main-is:          Main.hs
  hs-source-dirs:   app
  other-modules:    Paths_sil_interpreter
  autogen-modules:  Paths_sil_interpreter
  default-language: Haskell2010
  build-depends:    base >=4.14 && <5, filepath, sil-interpreter
  ghc-options:      -Wall

test-suite sil-interpreter-tests
  type:             exitcode-stdio-1.0
  main-is:          Tests.hs
  hs-source-dirs:   tests
  default-language: Haskell2010
  build-depends:    base >=4.14 && <5, HUnit, sil-interpreter
  ghc-options:      -Wall
